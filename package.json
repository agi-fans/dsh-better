{
  "name": "@agi-fans/dsh-better",
  "version": "0.1.1",
  "description": "Deepen prompts before sending and check subagent briefs in DeepSeek Harness (adapted from pi-better).",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agi-fans/dsh-better.git"
  },
  "homepage": "https://github.com/agi-fans/dsh-better#readme",
  "bugs": {
    "url": "https://github.com/agi-fans/dsh-better/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "prompt",
    "pi-better",
    "subagent"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prompts",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/host/index.ts --outfile dist/index.js --target node --format esm && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
